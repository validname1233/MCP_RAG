# MCP_RAG 配置模板——复制为 .env 并填写

# HTTP 监听端口
KB_PORT=3001

# MCP 端点路径（逗号分隔多个）。默认 /mcp（本地直连）；
# 经 Higress 网关 http://zyh.kyson.asia:28080/rag 透传时需含 /rag
KB_MCP_PATH=/mcp,/rag

# 对外基础 URL（签发管理页链接用它拼，不能填内网监听地址）
KB_PUBLIC_URL=http://zyh.kyson.asia:28080/rag

# MCP 主鉴权 key（bot 侧 mcp.json 的 apiKey 与此一致）
KB_BEARER_KEY=changeme

# 智谱 BigModel embedding（入库流水线用；留空 = 假向量联调模式）
# 与 qq-bot 侧的 EMBEDDING_API_KEY 同一账号同一把 key
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
